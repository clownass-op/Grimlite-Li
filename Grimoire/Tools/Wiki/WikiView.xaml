                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0" Source="{Binding Skill.ImageUrl}"
                                                               Width="46" Height="46" Stretch="Uniform"
                                                               VerticalAlignment="Top" Margin="0,2,10,0" />

                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Skill.Fields}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,0,0,4">
                                                                        <TextBlock x:Name="valueText" TextWrapping="Wrap" FontSize="12.5"
                                                                                   LineHeight="18" MaxWidth="460">
                                                                            <Run Text="{Binding Label}" FontFamily="Segoe UI Semibold"
                                                                                 Foreground="{StaticResource TextMid}" />
                                                                            <Run Text=": " FontFamily="Segoe UI Semibold"
                                                                                 Foreground="{StaticResource TextMid}" />
                                                                            <Run Text="{Binding Value}" Foreground="{StaticResource WikiText}" />
                                                                        </TextBlock>

                                                                        <StackPanel x:Name="valueList" Visibility="Collapsed" Margin="0,2,0,0">
                                                                            <TextBlock FontFamily="Segoe UI Semibold" FontSize="12.5"
                                                                                       Foreground="{StaticResource TextMid}"
                                                                                       Text="{Binding Label, StringFormat={}{0}:}" />
                                                                            <ItemsControl ItemsSource="{Binding ListValues}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding}" FontSize="12.5"
                                                                                                   Foreground="{StaticResource WikiText}"
                                                                                                   TextWrapping="Wrap" MaxWidth="460"
                                                                                                   Margin="10,2,0,0" LineHeight="17" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsList}" Value="True">
                                                                            <Setter TargetName="valueText" Property="Visibility" Value="Collapsed" />
                                                                            <Setter TargetName="valueList" Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Notes:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=notesHost}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="notesHost" />
                        <Image x:Name="imgNotesIcon" Height="16" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="genderToggle" Orientation="Horizontal" Visibility="Collapsed"
                                Margin="0,20,0,0">
                        <Button x:Name="btnMale" Content="Male" Click="btnMale_Click"
                                Style="{StaticResource WikiTabButton}"
                                Background="{StaticResource Accent}" Foreground="White" />
                        <Button x:Name="btnFemale" Content="Female" Click="btnFemale_Click"
                                Style="{StaticResource WikiTabButton}"
                                Background="{StaticResource WikiTabIdleBg}" Foreground="{StaticResource WikiTabIdleText}" />
                    </StackPanel>

                    <ItemsControl x:Name="icItemImageTabs" Visibility="Collapsed" Margin="0,20,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="ItemImageTab_Click"
                                        Tag="{Binding ImageUrl}"
                                        Style="{StaticResource WikiTabButton}"
                                        Background="{StaticResource WikiTabIdleBg}"
                                        Foreground="{StaticResource WikiTabIdleText}"
                                        Margin="0,0,3,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>

                    <Border BorderBrush="{StaticResource WikiRule}" BorderThickness="0,0,0,0"
                            Margin="0,0,0,0" Padding="0,10,0,0" HorizontalAlignment="Left">
                        <StackPanel HorizontalAlignment="Left">
                            <Image x:Name="imgArmor" Stretch="Uniform" MaxHeight="300" MaxWidth="300"
                                   HorizontalAlignment="Left" />
                            <Image x:Name="imgItemTab" Stretch="Uniform" MaxHeight="750" MaxWidth="750"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Left" Visibility="Collapsed" />
                            <TextBlock x:Name="txtImageUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="itemLinkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtItemLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtItemLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Image x:Name="imgItemLinkedPreview" Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- LOCATION DETAIL -->
            <ScrollViewer x:Name="locationDetailContent" Visibility="Collapsed"
                          Padding="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{x:Null}">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="36,28,36,32" MaxWidth="680" HorizontalAlignment="Left">

                    <TextBlock x:Name="txtLocName" FontFamily="Segoe UI Semibold" FontSize="24"
                               Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock FontSize="12" Margin="0,0,0,12">
                        <Run Text="AQWorlds Wiki" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="World" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="Locations" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runLocBreadcrumbName" Text="Entry" Foreground="{StaticResource WikiLink}" />
                    </TextBlock>

                    <ItemsControl x:Name="icLocTopIcons" Margin="0,0,0,8">
