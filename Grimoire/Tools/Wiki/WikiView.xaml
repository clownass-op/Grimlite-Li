                    <TextBlock FontSize="12" Margin="0,0,0,16">
                        <Run Text="AQWorlds Wiki" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="Items" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runBreadcrumbCategory" Text="Items" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runBreadcrumbName" Text="Entry" Foreground="{StaticResource WikiLink}" />
                    </TextBlock>

                    <ItemsControl x:Name="icEventIcons" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="70" Stretch="Uniform" Margin="0,0,6,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="icTopIcons" Margin="0,4,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Locations:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=locationsHost}" />
                    <StackPanel x:Name="locationsHost" />

                    <TextBlock x:Name="priceInline" Margin="0,8,0,0">
                        <Run Text="Price: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runPrice" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>
                    <StackPanel x:Name="priceHost" Margin="0,8,0,0" Visibility="Collapsed" />

                    <TextBlock x:Name="sellbackInline" Margin="0,8,0,0" Visibility="Collapsed">
                        <Run Text="Sellback: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runSellback" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>
                    <TextBlock Text="Sellback:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icSellback}" />
                    <ItemsControl x:Name="icSellback">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WikiListLine}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Rarity: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runRarity" Text="—" FontSize="13" />
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19">
                        <Run Text="Description: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runDescription" Text="" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Text="Special Effects:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icSpecialEffects}" />
                    <ItemsControl x:Name="icSpecialEffects">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WikiListLine}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Skills:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icClassSkills}" />
                    <ItemsControl x:Name="icClassSkills" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">

                                    <Button Click="SkillBlockHeader_Click" Tag="{Binding}"
                                            Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="headerBd" Background="{StaticResource Raised}"
                                                        BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                        CornerRadius="5" Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="headerBd" Property="Background" Value="{StaticResource RaisedHover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock FontFamily="Segoe UI Semibold" FontSize="12.5"
                                                   Foreground="{StaticResource Accent}" TextWrapping="Wrap">
                                            <Run Text="{Binding ChevronPrefix, Mode=OneWay}" />
                                            <Run Text="{Binding HeaderTitle}" />
                                        </TextBlock>
                                    </Button>

                                    <Border Background="{StaticResource WikiTabIdleBg}"
                                            BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,5,5" Padding="12">
