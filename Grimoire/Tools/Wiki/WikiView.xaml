                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Monsters:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icMonsters}" />
                    <ItemsControl x:Name="icMonsters">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="LocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}"
                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="NPCs:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icNpcs}" />
                    <ItemsControl x:Name="icNpcs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="LocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}"
                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Quests:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icQuests}" />
                    <ItemsControl x:Name="icQuests">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="LocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}"
                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Shops:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icShops}" />
                    <ItemsControl x:Name="icShops">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="LocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
