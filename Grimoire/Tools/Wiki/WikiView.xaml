<UserControl x:Class="Grimoire.Tools.Wiki.WikiView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Grimoire.Tools.Wiki"
        Background="#1A1A1F"
        Foreground="#F2F2F5"
        FontFamily="Segoe UI">

    <UserControl.Resources>

        <local:DepthToIndentConverter x:Key="DepthToIndentConverter" />

        <SolidColorBrush x:Key="App" Color="#1A1A1F" />
        <SolidColorBrush x:Key="Surface" Color="#212126" />
        <SolidColorBrush x:Key="Raised" Color="#26262C" />
        <SolidColorBrush x:Key="RaisedHover" Color="#2C2C33" />
        <SolidColorBrush x:Key="Hairline" Color="#34343B" />
        <SolidColorBrush x:Key="Accent" Color="#E11D48" />
        <SolidColorBrush x:Key="AccentDeep" Color="#BE123C" />
        <SolidColorBrush x:Key="TextHi" Color="#F2F2F5" />
        <SolidColorBrush x:Key="TextMid" Color="#9A9AA3" />
        <SolidColorBrush x:Key="TextLow" Color="#5C5C63" />

        <SolidColorBrush x:Key="WikiBg" Color="#1A1A1F" />
        <SolidColorBrush x:Key="WikiText" Color="#F2F2F5" />
        <SolidColorBrush x:Key="WikiMuted" Color="#9A9AA3" />
        <SolidColorBrush x:Key="WikiLink" Color="#E11D48" />
        <SolidColorBrush x:Key="WikiRule" Color="#34343B" />
        <SolidColorBrush x:Key="WikiTabIdleBg" Color="#26262C" />
        <SolidColorBrush x:Key="WikiTabIdleText" Color="#9A9AA3" />
        <SolidColorBrush x:Key="WikiTabActiveBg" Color="#E11D48" />

        <Style x:Key="SpinnerArc" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Data" Value="M 9,1 A 8,8 0 1 1 1,9" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.Angle"
                                From="0" To="360" Duration="0:0:0.8"
                                RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        </Style>

        <Style x:Key="WikiLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource WikiText}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style x:Key="WikiListLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource WikiText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="WikiLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" FontSize="13"
                                       Foreground="{StaticResource WikiLink}" TextWrapping="Wrap"
                                       LineHeight="18" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource WikiText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#0B1420" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDeep}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="EntryListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                BorderThickness="0,0,0,0" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="rail" Width="2.5" HorizontalAlignment="Left"
                                        Background="{StaticResource Accent}" Opacity="0" Margin="-10,-9,0,-9" />
                                <ContentPresenter Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RaisedHover}" />
                                <Setter TargetName="rail" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#C6C8D4" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="WikiTabButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBd" Background="{StaticResource Accent}" CornerRadius="3" Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="{StaticResource AccentDeep}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" Height="10">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ThinScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="logColumnDef" Width="250" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: controls + entry list -->
        <Border Grid.Column="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource SearchShell}" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock Text="Search entries…" Foreground="{StaticResource TextLow}"
                                       FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="txtSearch"
                                     Height="32" Padding="11,7,4,7"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextHi}" CaretBrush="{StaticResource Accent}"
                                     FontSize="12.5"
                                     TextChanged="txtSearch_TextChanged" />
                        </Grid>

                        <TextBlock Grid.Column="1" Text="⌕" FontSize="15"
                                   Foreground="{StaticResource Accent}"
                                   Margin="0,0,11,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <TextBlock x:Name="txtCount" DockPanel.Dock="Top" Text=""
                           FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource TextLow}"
                           Margin="2,0,0,10" Visibility="Collapsed" />

                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="0,0,0,1" Margin="1,0,0,10" />

                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="pinnedCategoryBar" Grid.Row="0" Visibility="Collapsed"
                            Background="{StaticResource Raised}" BorderBrush="{StaticResource Hairline}"
                            BorderThickness="0,0,0,1" CornerRadius="5" Padding="8,7" Margin="0,0,0,4">
                        <TextBlock x:Name="txtPinnedCategory" Foreground="{StaticResource Accent}"
                                   FontFamily="Segoe UI Semibold" FontSize="12" />
                    </Border>

                    <ScrollViewer x:Name="categoryScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="categoryScroll_ScrollChanged"
                                  AllowDrop="True"
                                  DragOver="icCategories_DragOver" Drop="icCategories_Drop"
                                  DragEnter="icCategories_DragEnter" DragLeave="icCategories_DragLeave">
                        <Grid>
                            <ItemsControl x:Name="icCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,2">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Click="CategoryChevron_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="8,9,6,9" HorizontalContentAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="{Binding ChevronGlyph}"
                                                           Foreground="{StaticResource TextMid}" FontSize="11"
                                                           Width="16" VerticalAlignment="Center" />
                                            </Button>

                                            <Button Grid.Column="1" Click="CategoryHeader_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="10,9,4,9" HorizontalContentAlignment="Stretch"
                                                    PreviewMouseLeftButtonDown="CategoryHeader_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="CategoryHeader_PreviewMouseMove">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="nameText" Grid.Column="0" Text="{Binding Name}"
                                                               Foreground="{StaticResource TextHi}"
                                                               FontFamily="Segoe UI Semibold" FontSize="13"
                                                               VerticalAlignment="Center" />

                                                    <Path x:Name="loadingSpinner" Grid.Column="1"
                                                          Style="{StaticResource SpinnerArc}" Width="13" Height="13" StrokeThickness="2"
                                                          Stroke="White" Margin="6,0,4,0" VerticalAlignment="Center"
                                                          Visibility="Collapsed" />

                                                    <TextBlock x:Name="statusText" Grid.Column="2" Text="{Binding StatusText}"
                                                               Foreground="{StaticResource TextLow}"
                                                               FontFamily="Consolas" FontSize="10.5"
                                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="2" Click="CategoryRefresh_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="6,9,8,9" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowRetry}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="↻" FontSize="13"
                                                           Foreground="{StaticResource Accent}" />
                                            </Button>
                                        </Grid>

                                        <ListBox ItemsSource="{Binding FilteredEntries}"
                                                 DisplayMemberPath="Name"
                                                 SelectionChanged="lstEntries_SelectionChanged"
                                                 Margin="16,0,0,4"
                                                 MaxHeight="380"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource EntryListBox}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                                <Condition Binding="{Binding HasChildren}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                        </ListBox>

                                        <ItemsControl ItemsSource="{Binding Children}" Margin="18,0,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,2">

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0" Click="CategoryHeader_Click" Tag="{Binding}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Cursor="Hand" Padding="10,7,4,7" HorizontalContentAlignment="Stretch">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised}" />
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="childChevronText" Grid.Column="0" Text="{Binding ChevronGlyph}"
                                                                               Foreground="{StaticResource TextMid}" FontSize="10"
                                                                               Width="14" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="childNameText" Grid.Column="1" Text="{Binding Name}"
                                                                               Foreground="{StaticResource TextHi}"
                                                                               FontSize="12.5" VerticalAlignment="Center" />
                                                                     <Path x:Name="childLoadingSpinner" Grid.Column="2"
                                                                           Style="{StaticResource SpinnerArc}" Width="11" Height="11" StrokeThickness="1.5"
                                                                           Stroke="White" Margin="6,0,4,0" VerticalAlignment="Center"
                                                                           Visibility="Collapsed" />
                                                                    <TextBlock x:Name="childStatusText" Grid.Column="3" Text="{Binding StatusText}"
                                                                               Foreground="{StaticResource TextLow}"
                                                                               FontFamily="Consolas" FontSize="10"
                                                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                </Grid>
                                                            </Button>

                                                            <Button Grid.Column="1" Click="CategoryRefresh_Click" Tag="{Binding}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Cursor="Hand" Padding="6,7,4,7" VerticalAlignment="Center">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowRetry}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="↻" FontSize="12"
                                                                           Foreground="{StaticResource Accent}" />
                                                            </Button>
                                                        </Grid>

                                                        <ListBox ItemsSource="{Binding FilteredEntries}"
                                                                 DisplayMemberPath="Name"
                                                                 SelectionChanged="lstEntries_SelectionChanged"
                                                                 Margin="14,0,0,4"
                                                                 MaxHeight="320"
                                                                 ScrollViewer.CanContentScroll="True"
                                                                 VirtualizingPanel.IsVirtualizing="True"
                                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                                            <ListBox.Style>
                                                                <Style TargetType="ListBox" BasedOn="{StaticResource EntryListBox}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ListBox.Style>
                                                        </ListBox>

                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="childNameText" Property="Foreground" Value="White" />
                                                            <Setter TargetName="childStatusText" Property="Foreground" Value="White" />
                                                            <Setter TargetName="childChevronText" Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <Setter TargetName="childLoadingSpinner" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="nameText" Property="Foreground" Value="White" />
                                        <Setter TargetName="statusText" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter TargetName="loadingSpinner" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- MIDDLE: detail view -->
        <Grid Grid.Column="1" Background="{StaticResource WikiBg}">

            <StackPanel x:Name="emptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="260">
                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource WikiTabIdleBg}"
                        BorderBrush="{StaticResource WikiRule}" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource WikiMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No entry selected" Foreground="{StaticResource WikiText}"
                           FontFamily="Segoe UI Semibold" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Scrape a category, then choose an entry on the left to inspect its data here."
                           Foreground="{StaticResource WikiMuted}" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" LineHeight="18" />
            </StackPanel>

            <!-- ITEM DETAIL -->
            <ScrollViewer x:Name="detailContent" Visibility="Collapsed"
                          Padding="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{x:Null}">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
