                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Location:" Style="{StaticResource WikiLabel}" Margin="0,4,0,2" />
                    <Button x:Name="btnMonsterLocation" Click="MonsterLink_Click"
                            Style="{StaticResource WikiLinkButton}" Margin="0,0,0,4" />

                    <TextBlock Margin="0,6,0,0">
                        <Run Text="Level: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runMonsterLevel" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Difficulty: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runMonsterDifficulty" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Total HP: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runMonsterTotalHp" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Text="Base Stats:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icBaseStats}" />
                    <ItemsControl x:Name="icBaseStats">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WikiListLine}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Attacks:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icAttacks}" />
                    <ItemsControl x:Name="icAttacks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WikiListLine}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Attacks:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icPhaseGroups}" />
                    <ItemsControl x:Name="icPhaseGroups" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">

                                    <Border Background="{StaticResource Accent}" CornerRadius="5"
                                            Padding="10,7" Margin="0,4,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Label}" FontFamily="Segoe UI Semibold"
                                                   FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Blocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">

                                                    <Button Click="SkillBlockHeader_Click" Tag="{Binding}"
                                                            Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="headerBd" Background="{StaticResource Raised}"
                                                                        BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                                        CornerRadius="5" Padding="10,8">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="headerBd" Property="Background" Value="{StaticResource RaisedHover}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock FontFamily="Segoe UI Semibold" FontSize="12.5"
                                                                   Foreground="{StaticResource Accent}" TextWrapping="Wrap">
                                                            <Run Text="{Binding ChevronPrefix, Mode=OneWay}" />
                                                            <Run Text="{Binding HeaderTitle}" />
                                                        </TextBlock>
                                                    </Button>

                                                    <Border Background="{StaticResource WikiTabIdleBg}"
                                                            BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,1,1"
                                                            CornerRadius="0,0,5,5" Padding="12,12,12,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>

                                                                        <Border x:Name="tableBd" Background="{StaticResource Surface}"
                                                                                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                                                CornerRadius="4" Margin="0,0,0,8">
                                                                            <StackPanel>
                                                                                <Border Background="#2C2C33" CornerRadius="3,3,0,0" Padding="10,7">
                                                                                    <TextBlock Text="{Binding Skill.Name}" Foreground="{StaticResource TextHi}"
                                                                                               FontFamily="Segoe UI Semibold" FontSize="12.5"
                                                                                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                                                                                </Border>
                                                                                <ItemsControl ItemsSource="{Binding Skill.Fields}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="108" />
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Border Grid.Column="0" Background="{StaticResource Raised}"
                                                                                                        BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,1"
                                                                                                        Padding="8,6">
                                                                                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Right"
                                                                                                               FontFamily="Segoe UI Semibold" FontSize="11.5"
                                                                                                               Foreground="{StaticResource TextMid}" TextWrapping="Wrap" />
                                                                                                </Border>
                                                                                                <Border Grid.Column="1" BorderBrush="{StaticResource Hairline}"
                                                                                                        BorderThickness="0,0,0,1" Padding="8,6">
                                                                                                    <StackPanel>
                                                                                                        <TextBlock x:Name="valueText" Text="{Binding Value}" FontSize="12"
                                                                                                                   Foreground="{StaticResource WikiText}" TextWrapping="Wrap" />
                                                                                                        <ItemsControl x:Name="valueList" ItemsSource="{Binding ListValues}" Visibility="Collapsed">
                                                                                                            <ItemsControl.ItemTemplate>
                                                                                                                <DataTemplate>
                                                                                                                    <TextBlock Text="{Binding}" FontSize="12"
                                                                                                                               Foreground="{StaticResource WikiText}"
                                                                                                                               TextWrapping="Wrap" Margin="0,0,0,3" />
                                                                                                                </DataTemplate>
                                                                                                            </ItemsControl.ItemTemplate>
                                                                                                        </ItemsControl>
                                                                                                    </StackPanel>
                                                                                                </Border>
                                                                                            </Grid>
                                                                                            <DataTemplate.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsList}" Value="True">
                                                                                                    <Setter TargetName="valueText" Property="Visibility" Value="Collapsed" />
                                                                                                    <Setter TargetName="valueList" Property="Visibility" Value="Visible" />
                                                                                                </DataTrigger>
                                                                                            </DataTemplate.Triggers>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <StackPanel x:Name="linkPanel" HorizontalAlignment="Center"
                                                                                    Margin="0,0,0,8" Visibility="Collapsed">
                                                                            <TextBlock Text="&#8595;" FontSize="16" Foreground="{StaticResource TextLow}"
                                                                                       HorizontalAlignment="Center" />
                                                                            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Accent}"
                                                                                    BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding LinkText}" FontSize="11" FontStyle="Italic"
                                                                                           Foreground="{StaticResource TextMid}" TextWrapping="Wrap"
                                                                                           TextAlignment="Center" MaxWidth="360" />
                                                                            </Border>
                                                                        </StackPanel>

                                                                    </Grid>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                                            <Setter TargetName="tableBd" Property="Visibility" Value="Collapsed" />
                                                                            <Setter TargetName="linkPanel" Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>

                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Temporary Items Dropped:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icTempItemsDropped}" />
                    <ItemsControl x:Name="icTempItemsDropped">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="MonsterLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Items Dropped:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icItemsDropped}" />
                    <ItemsControl x:Name="icItemsDropped">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2,0,2">
                                    <Button Click="MonsterLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                            IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}"
                                            Padding="0,2,0,2" />
                                    <ItemsControl ItemsSource="{Binding IconUrls}" Margin="4,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}" Height="13" Stretch="Uniform"
                                                       Margin="3,0,0,0" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Notes:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=monsterNotesHost}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="monsterNotesHost" />
                        <Image x:Name="imgMonsterNotesIcon" Height="16" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <ItemsControl x:Name="icMonsterImageTabs" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Click="MonsterImageTab_Click"
                                            Tag="{Binding ImageUrl}"
                                            Style="{StaticResource WikiTabButton}"
                                            Background="{StaticResource WikiTabIdleBg}"
                                            Foreground="{StaticResource WikiTabIdleText}"
                                            Padding="16,7" FontSize="12" Margin="0,0,3,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource WikiRule}" BorderThickness="0,0,0,1"
                                Margin="0,0,0,10"
                                Visibility="{Binding Visibility, ElementName=icMonsterImageTabs}" />

                        <Image x:Name="imgMonster" Stretch="Uniform" MaxHeight="300" MaxWidth="400"
                               HorizontalAlignment="Left" />
                        <TextBlock x:Name="txtMonsterImageUrl" FontSize="9.5" FontFamily="Consolas"
                                   Foreground="{StaticResource WikiMuted}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="400" />
                    </StackPanel>

                    <Border x:Name="monsterLinkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtMonsterLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtMonsterLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Image x:Name="imgMonsterLinkedPreview" Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- SHOP DETAIL -->
            <ScrollViewer x:Name="shopDetailContent" Visibility="Collapsed"
                          Padding="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{x:Null}">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="36,28,36,32" MaxWidth="680" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">

                    <TextBlock x:Name="txtShopName" FontFamily="Segoe UI Semibold" FontSize="24"
                               Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock FontSize="12" Margin="0,0,0,12">
                        <Run Text="AQWorlds Wiki" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="World" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runShopBreadcrumbCategory" Text="Shops" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runShopBreadcrumbName" Text="Entry" Foreground="{StaticResource WikiLink}" />
                    </TextBlock>

                    <ItemsControl x:Name="icShopTopIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Location:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icShopLocation}" />
                    <ItemsControl x:Name="icShopLocation" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="ShopLocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel x:Name="shopTabsPanel" Orientation="Horizontal" Margin="0,16,0,0" />

                    <Grid x:Name="shopTableHeader" Margin="0,10,0,0" Background="#26262C">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShopNameCol" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Name" Foreground="{StaticResource TextHi}"
                                   FontFamily="Segoe UI Semibold" FontSize="12" Margin="4,7" />
                        <TextBlock Grid.Column="3" Text="Price" Foreground="{StaticResource TextHi}"
                                   FontFamily="Segoe UI Semibold" FontSize="12" Margin="4,7" />
                    </Grid>

                    <StackPanel x:Name="shopTablePanel" Margin="0,0,0,0" />

                    <Border x:Name="shopLinkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtShopLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtShopLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Image x:Name="imgShopLinkedPreview" Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- QUEST DETAIL CONTENT -->
            <ScrollViewer x:Name="questDetailContent" Visibility="Collapsed"
                          Padding="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{x:Null}">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="36,28,36,32" MaxWidth="680" HorizontalAlignment="Left">

                    <TextBlock x:Name="txtQuestName" FontFamily="Segoe UI Semibold" FontSize="24"
                               Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock FontSize="12" Margin="0,0,0,12">
                        <Run Text="AQWorlds Wiki" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="World" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="Quests" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runQuestBreadcrumbName" Text="Entry" Foreground="{StaticResource WikiLink}" />
                    </TextBlock>

                    <ItemsControl x:Name="icQuestEventIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="70" Stretch="Uniform" Margin="0,0,6,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="icQuestTopIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtQuestJumpTo" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource WikiMuted}" Margin="0,0,0,12" Visibility="Collapsed" />

                    <StackPanel x:Name="questGroupsPanel" />

                    <Border x:Name="questLinkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtQuestLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtQuestLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Image x:Name="imgQuestLinkedPreview" Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- NPC DETAIL -->
            <ScrollViewer x:Name="npcDetailContent" Visibility="Collapsed"
                          Padding="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{x:Null}">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="36,28,36,32" MaxWidth="680" HorizontalAlignment="Left">

                    <TextBlock x:Name="txtNpcName" FontFamily="Segoe UI Semibold" FontSize="24"
                               Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock FontSize="12" Margin="0,0,0,12">
                        <Run Text="AQWorlds Wiki" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="World" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="NPCs" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runNpcBreadcrumbName" Text="Entry" Foreground="{StaticResource WikiLink}" />
                    </TextBlock>

                    <ItemsControl x:Name="icNpcEventIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="70" Stretch="Uniform" Margin="0,0,6,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="icNpcTopIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel x:Name="npcDialogueTabsPanel" Orientation="Horizontal" Margin="0,4,0,0" />

                    <Border x:Name="npcDialogueBorder" Background="{StaticResource WikiTabIdleBg}"
                            BorderBrush="{StaticResource WikiRule}" BorderThickness="1"
                            CornerRadius="0,5,5,5" Padding="14" Margin="0,0,0,4">
                        <ContentControl x:Name="npcDialogueContentHost" />
                    </Border>

                    <TextBlock Text="Location:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icNpcLocation}" />
                    <ItemsControl x:Name="icNpcLocation" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="NpcLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}"
                                        Margin="0,0,10,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Notes:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=npcNotesHost}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="npcNotesHost" />
                        <Image x:Name="imgNpcNotesIcon" Height="16" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="npcScreensSection" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock Text="Images:" Style="{StaticResource WikiLabel}" Margin="0,0,0,6" />
                        <WrapPanel x:Name="npcScreenTabsPanel" Orientation="Horizontal" Margin="0,0,0,2" />
                        <Border BorderBrush="{StaticResource WikiRule}" BorderThickness="0,0,0,1" Margin="0,0,0,14" />
                        <StackPanel x:Name="npcScreenImagesPanel" />
                    </StackPanel>

                    <StackPanel x:Name="npcSingleImagePanel" Margin="0,20,0,0" Visibility="Collapsed">
                        <Image x:Name="imgNpcSingle" Stretch="Uniform" MaxHeight="300" MaxWidth="400"
                               HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock x:Name="txtNpcThanks" FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource WikiMuted}" Margin="0,14,0,0" Visibility="Collapsed" />

                    <Border x:Name="npcLinkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtNpcLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtNpcLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Image x:Name="imgNpcLinkedPreview" Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ENHANCEMENT DETAIL -->
            <ScrollViewer x:Name="enhancementDetailContent" Visibility="Collapsed"
                          Padding="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{x:Null}">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true" Width="10">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="36,28,36,32" MaxWidth="680" HorizontalAlignment="Left">

                    <TextBlock x:Name="txtEnhancementName" FontFamily="Segoe UI Semibold" FontSize="24"
                               Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock FontSize="12" Margin="0,0,0,12">
                        <Run Text="AQWorlds Wiki" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run Text="Enhancements" Foreground="{StaticResource WikiLink}" />
                        <Run Text=" » " Foreground="{StaticResource WikiMuted}" />
                        <Run x:Name="runEnhancementBreadcrumbName" Text="Entry" Foreground="{StaticResource WikiLink}" />
                    </TextBlock>

                    <ItemsControl x:Name="icEnhancementEventIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="70" Stretch="Uniform" Margin="0,0,6,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="icEnhancementTopIcons" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="34" Stretch="Uniform"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Location:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icEnhancementLocation}" />
                    <ItemsControl x:Name="icEnhancementLocation" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="EnhancementLocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="enhancementGroupsPanel" Margin="0,12,0,0" />

                    <Border x:Name="enhancementLinkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtEnhancementLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtEnhancementLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="{StaticResource WikiMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Image x:Name="imgEnhancementLinkedPreview" Stretch="Uniform" MaxHeight="260" MaxWidth="320"
                                   HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border x:Name="detailLoadingOverlay" Background="#CC1A1A1F" Visibility="Collapsed"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Style="{StaticResource SpinnerArc}" Width="34" Height="34" StrokeThickness="3" />
                    <TextBlock Text="Loading entry…" Foreground="{StaticResource WikiMuted}"
                               FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- RIGHT: live log -->
        <Border x:Name="logPanel" Grid.Column="2" Background="#1A1A1F" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="LIVE LOG" Style="{StaticResource Eyebrow}" />
                </StackPanel>
                <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLog" FontFamily="Consolas" FontSize="11"
                               Foreground="#7EC8FF" TextWrapping="Wrap" LineHeight="17" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
