                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Map Name: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runMapName" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Room Limit: " FontFamily="Segoe UI Semibold" Foreground="{StaticResource WikiText}" FontSize="13" />
                        <Run x:Name="runRoomLimit" Text="—" Foreground="{StaticResource WikiText}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Text="Access Points:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=icAccessPoints}" />
                    <ItemsControl x:Name="icAccessPoints">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="LocationLink_Click" Tag="{Binding}" Content="{Binding Text}"
                                        IsEnabled="{Binding HasLink}" Style="{StaticResource WikiLinkButton}"
                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Note:" Style="{StaticResource WikiLabel}"
                               Visibility="{Binding Visibility, ElementName=locNotesHost}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="locNotesHost" />
                        <Image x:Name="imgLocNotesIcon" Height="16" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="screensSection" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock Text="Screens:" Style="{StaticResource WikiLabel}" Margin="0,0,0,6" />
                        <WrapPanel x:Name="screenTabsPanel" Orientation="Horizontal" Margin="0,0,0,2" />
                        <Border BorderBrush="{StaticResource WikiRule}" BorderThickness="0,0,0,1" Margin="0,0,0,14" />
                        <StackPanel x:Name="screenImagesPanel" />
                    </StackPanel>

                    <Border x:Name="linkedPreviewPanel" Visibility="Collapsed" Margin="0,24,0,0"
                            Background="{StaticResource WikiTabIdleBg}" BorderBrush="{StaticResource WikiRule}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LINKED PAGE PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtLinkedPreviewName" FontFamily="Segoe UI Semibold" FontSize="15"
                                       Foreground="{StaticResource WikiText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtLinkedPreviewUrl" FontSize="9.5" FontFamily="Consolas"
